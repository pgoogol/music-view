# Skopiuj do .env i uzupełnij. Plik .env NIE trafia do repo (D14) —
# sekrety wyłącznie w zmiennych środowiskowych.

# Spotify — Client Credentials (metadane/ISRC) + OAuth PKCE (playlisty, D4)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Adres powrotu z ekranu zgody; musi być identyczny z wpisanym w dashboardzie
# aplikacji Spotify. Odkomentuj tylko, żeby nadpisać wartość domyślną
# (http://127.0.0.1:8080/api/auth/spotify/callback) — pusty łańcuch zepsuje logowanie.
# SPOTIFY_REDIRECT_URI=

# Provider LLM do analizy utworów (D15) — provider i model tylko w konfiguracji
# LLM_PROVIDER: openai (i API zgodne z OpenAI) | anthropic; LLM_BASE_URL opcjonalny
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# MusicBrainz wymaga User-Agent z kontaktem (D14), np.:
# music-view/0.1 (https://github.com/pgoogol/music-view; you@example.com)
MB_USER_AGENT=

# Tłumaczenie tekstów (D32): wejście i sufit odpowiedzi muszą zmieścić się
# w oknie kontekstu modelu. Przy lokalnym modelu na 8 GB VRAM zacznij od 2500/1500.
# LLM_LYRICS_MAX_CHARS=
# LLM_LYRICS_MAX_TOKENS=

# LRCLIB — teksty utworów (D32). Bez klucza; serwis prosi tylko o identyfikację
# klienta. Odkomentuj, żeby nadpisać wartość domyślną z application.yml.
# LRCLIB_USER_AGENT=
