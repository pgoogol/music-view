# Serwer statyków frontu + proxy API (M5.3/D30).
#
# Szablon obrazu nginx: entrypoint podstawia ${API_HOST} i ${API_PORT} ze
# zmiennych środowiskowych. Zmienne samego nginxa ($host, $uri, …) zapisujemy
# bez klamer, więc podstawianie ich nie rusza.
#
# Bez fallbacku SPA: stan widoku siedzi w hashu (`#/library?…`, D22), więc
# przeglądarka nigdy nie prosi serwera o /library — wystarczy index.html pod /.
# Rezygnacja z routera z M3.1 opłaca się tu drugi raz.

server {
    listen 80;
    server_name _;

    # adres backendu jest jedyną rzeczą, którą front musi wiedzieć o świecie —
    # trzymamy ją w konfiguracji proxy, nie w zbudowanym pakiecie JS, więc ten
    # sam obraz działa lokalnie i na serwerze
    location /api/ {
        proxy_pass http://${API_HOST}:${API_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # import playlist i wzbogacanie potrafią trwać dłużej niż domyślne 60 s
        proxy_read_timeout 300s;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ =404;
    }
}
